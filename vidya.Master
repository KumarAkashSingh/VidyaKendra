<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="vidya.master.cs" Inherits="Vidyakendraa.vidya" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8">
    <title>VidyaKendra</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Libraries Stylesheet -->
    <link href="lib/animate/animate.min.css" rel="stylesheet">
    <link href="lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <!-- Customized Bootstrap Stylesheet -->
    <link href="css/bootstrap.min.css" rel="stylesheet">
    <!-- Template Stylesheet -->
    <link href="css/style.css" rel="stylesheet">
    <style>
        .chatbot-button {
            position: fixed;
            right: 20px;
            bottom: 20px;
            width: 60px;
            height: 60px;
            background: #0d6efd;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #fff;
            font-size: 30px;
            cursor: pointer;
            z-index: 999999;
        }

        .chat-window {
            position: fixed;
            right: 20px;
            bottom: 95px;
            width: 380px;
            height: 500px;
            background: #202123;
            border-radius: 15px;
            display: none;
            flex-direction: column;
            overflow: hidden;
            z-index: 99999;
        }

        .chat-header {
            background: #343541;
            color: #fff;
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: bold;
        }

        .chat-close {
            cursor: pointer;
            font-size: 24px;
        }

        .chat-body {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            background: #343541;
        }

        .chat-footer {
            padding: 15px;
            background: #202123;
        }

        .faq-btn {
            display: block;
            width: 100%;
            margin-bottom: 8px;
            padding: 10px;
            background: #444654;
            color: #fff;
            border-radius: 8px;
            text-decoration: none;
        }

            .faq-btn:hover {
                background: #0d6efd;
                color: #fff;
            }

        .user {
            background: #0d6efd;
            color: #fff;
            padding: 10px;
            border-radius: 10px;
            margin: 10px 0;
            text-align: right;
        }

        .bot {
            background: #444654;
            color: #fff;
            padding: 10px;
            border-radius: 10px;
            margin: 10px 0;
        }
    </style>
    <script>
        function openChat() {
            document.getElementById("chatWindow").style.display = "flex";
        }

        function closeChat() {
            document.getElementById("chatWindow").style.display = "none";
        }
    </script>

</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>
        <!-- TOP HEADER -->
        <div class="container-fluid px-5 py-3 d-none d-lg-block">
            <div class="row align-items-center">

                <!-- LOGO -->
                <div class="col-lg-3 text-start">
                    <a href="Home.aspx" class="navbar-brand m-0">
                        <img src="images/VidyaSchoolLogo.jpg" style="height: 55px;" />
                    </a>
                </div>

                <!-- SEARCH -->
                <div class="col-lg-6">
                    <div class="input-group">
                        <asp:TextBox ID="txtSearch" runat="server" CssClass="form-control" placeholder="Search books..." />
                        <asp:Button ID="btnSearch" runat="server" Text="Search" CssClass="btn btn-primary" />
                    </div>
                </div>

                <!-- RIGHT ICONS -->
                <div class="col-lg-3 text-end">
                    <asp:LinkButton ID="btnLogout" runat="server"
                        CssClass="btn btn-outline-primary me-2"
                        OnClick="btnLogout_Click">Logout</asp:LinkButton>
                    <a href="AddToCart.aspx" class="btn btn-outline-dark position-relative">
                        <i class="fas fa-shopping-cart"></i>
                        <asp:Label ID="lblCartCount" runat="server"
                            CssClass="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        </asp:Label>
                    </a>
                </div>
            </div>
        </div>

        <!-- NAVBAR -->
        <div class="container-fluid bg-primary">
            <div class="container">
                <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarMain">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarMain">
                        <div class="navbar-nav ms-auto">
                            <a href="Home.aspx" class="nav-link">Home</a>
                            <!-- 🔽 DISCOVER MENU -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="discoverMenu"
                                    role="button" data-bs-toggle="dropdown">Discover
                                </a>
                                <ul class="dropdown-menu">
                                    <!-- 🔽 SUBMENU -->
                                    <li class="dropdown-submenu">
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="Download.aspx">Single Translate</a></li>
                                            <li><a class="dropdown-item" href="TransPDF.aspx">Multi PDF Translate</a></li>
                                            <li><a class="dropdown-item" href="Eventgallery.aspx">Event Gallery</a></li>
                                            <li><a class="dropdown-item" href="DirectorMassage.aspx">Director Massage</a></li>
                                            <li><a class="dropdown-item" href="FAQ.aspx">FAQ</a></li>
                                        </ul>
                                    </li>

                                </ul>
                            </li>

                            <a href="AboutUs.aspx" class="nav-link">About Us</a>
                            <a href="ContactUs.aspx" class="nav-link">Contact</a>
                            <a href="Allcourse.aspx" class="nav-link">All Books</a>
                            <a runat="server" id="liRegister" href="Reg.aspx" class="nav-link">Register</a>
                            <a runat="server" id="liLogin" href="Login.aspx" class="nav-link">Login</a>

                        </div>
                    </div>
                </nav>
            </div>
        </div>

        <!-- PAGE CONTENT chatbot -->
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            <asp:UpdatePanel ID="updChat" runat="server">
                <ContentTemplate>

                    <!-- Floating Button -->
                    <div class="chatbot-button" onclick="OpenChat();">
                        💬
                    </div>

                    <!-- Chat Window -->
                    <div id="chatWindow" class="chat-window">

                        <div class="chat-header">
                            🤖 Vidya AI Assistant
                <span class="close-btn" onclick="CloseChat();">&times;</span>
                        </div>

                        <div class="chat-body" id="chatBody" runat="server">
                            <asp:Literal ID="litChat" runat="server"></asp:Literal>
                        </div>

                        <div class="chat-footer">
                        </div>

                    </div>

                </ContentTemplate>
            </asp:UpdatePanel>
        </asp:ContentPlaceHolder>
        <!-- FOOTER -->
        <!-- Footer Start -->
        <div class="container-fluid footer py-5 wow fadeIn" data-wow-delay="0.2s">
            <div class="container py-5">
                <div class="row g-4 rounded mb-5" style="background: rgba(255, 255, 255, .03);">
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="rounded p-4">
                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mb-4"
                                style="width: 70px; height: 70px;">
                                <i class="fas fa-map-marker-alt fa-2x text-primary"></i>
                            </div>
                            <div>
                                <h4 class="text-white">Address</h4>
                                <p class="mb-2">Bihar</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="rounded p-4">
                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mb-4"
                                style="width: 70px; height: 70px;">
                                <i class="fas fa-envelope fa-2x text-primary"></i>
                            </div>
                            <div>
                                <h4 class="text-white">Mail Us</h4>
                                <p class="mb-2">info@vidya.com</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="rounded p-4">
                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mb-4"
                                style="width: 70px; height: 70px;">
                                <i class="fab fa-firefox-browser fa-2x text-primary"></i>
                            </div>
                            <div>
                                <h4 class="text-white">Vidyakedra@ex.com</h4>
                                <p class="mb-2">9198818395</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-5">
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="footer-item d-flex flex-column">
                            <div class="footer-item">
                                <h4 class="text-primary mb-4">Newsletter</h4>
                                <p class="mb-3">
                                    Dolor amet sit justo amet elitr clita ipsum elitr est.Lorem ipsum dolor sit
                                amet, consectetur adipiscing elit consectetur adipiscing elit.
                                </p>
                                <div class="position-relative mx-auto rounded-pill">
                                    <input class="form-control rounded-pill w-100 py-3 ps-4 pe-5" type="text"
                                        placeholder="Enter your email">
                                    <button type="button"
                                        class="btn btn-primary rounded-pill position-absolute top-0 end-0 py-2 mt-2 me-2">
                                        SignUp</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="footer-item d-flex flex-column">
                            <h4 class="text-primary mb-4">Customer Service</h4>
                            <a href="ContactUs.aspx" class=""><i class="fas fa-angle-right me-2"></i>Contact Us</a>
                            <a href="Management.aspx" class=""><i class="fas fa-angle-right me-2"></i>Management</a>
                            <a href="AboutUs.aspx" class=""><i class="fas fa-angle-right me-2"></i>About Us</a>
                            <a href="FAQ.aspx" class=""><i class="fas fa-angle-right me-2"></i>FAQ</a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="footer-item d-flex flex-column">
                            <h4 class="text-primary mb-4">Information</h4>                            
                            <a href="#!" class=""><i class="fas fa-angle-right me-2"></i>Order History</a>
                            <a href="#!" class=""><i class="fas fa-angle-right me-2"></i>Site Map</a>
                            <a href="#!" class=""><i class="fas fa-angle-right me-2"></i>Privacy Policy</a>
                            <a href="#!" class=""><i class="fas fa-angle-right me-2"></i>Terms & Conditions</a>                            
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="footer-item d-flex flex-column">
                            <h4 class="text-primary mb-4">Extras</h4>
                            <a href="#!" class=""><i class="fas fa-angle-right me-2"></i>Brands</a>
                            <a href="#!" class=""><i class="fas fa-angle-right me-2"></i>Gift Vouchers</a>
                            <a href="#!" class=""><i class="fas fa-angle-right me-2"></i>Wishlist</a>
                            <a href="AddToCart.aspx" class=""><i class="fas fa-angle-right me-2"></i>Cart</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Footer End -->
        <!-- Copyright Start -->
        <div class="container-fluid copyright py-4">
            <div class="container">
                <div class="row g-4 align-items-center">
                    <div class="col-md-6 text-center text-md-start mb-md-0">
                        <span class="text-white"><a href="#!" class="border-bottom text-white"><i
                            class="fas fa-copyright text-light me-2"></i>VidyaKendra</a>, All right
                        reserved.</span>
                    </div>
                    <div class="col-md-6 text-center text-md-end text-white">
                        Designed By <a class="border-bottom text-white" href="#">VidyaKredra</a>.
                    Distributed By <a class="border-bottom text-white" href="#"
                        target="_blank">Akash Singh</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
